# Admin Web Dashboard — добавьте в /opt/kitchens-bot/.env

ADMIN_DASHBOARD_USER=admin
# Пароль 1111 задаётся в БД при первом запуске; смена — в дашборде (Настройки)
ADMIN_SESSION_SECRET=generate-random-32-chars-minimum
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8081
ADMIN_UPLOADS_DIR=/opt/kitchens-bot/uploads

# DATABASE_URL уже должен быть задан для бота

# Первый вход: логин admin, пароль 1111
# URL: https://kitchen.alexklyvibe.ru/login
