# Шаблон .env для заказчика после передачи проекта
# Скопируйте в корень проекта: copy delivery\env.handover.example .env

# --- Telegram (заменить на свои) ---
TELEGRAM_BOT_TOKEN=ЗАМЕНИТЬ-токен-от-BotFather
TELEGRAM_CHAT_ID=ЗАМЕНИТЬ-id-группы-менеджеров
TELEGRAM_ADMIN_IDS=ЗАМЕНИТЬ-id-админа-в-Telegram

# --- ProxyAPI / STT ---
PROXY_API_KEY=ЗАМЕНИТЬ-ключ-ProxyAPI
PROXY_BASE_URL=https://openai.api.proxyapi.ru/v1
OPENAI_MODEL_VOICE=whisper-1

# --- PostgreSQL (после restore из delivery/kitchens_bot_handover.dump) ---
DATABASE_URL=postgresql://kitchens:kitchens@127.0.0.1:5433/kitchens_bot

# --- Админка ---
ADMIN_DASHBOARD_USER=admin
ADMIN_SESSION_SECRET=ЗАМЕНИТЬ-случайная-строка-минимум-32-символа
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8081
CATALOG_PUBLIC_BASE_URL=https://ВАШ-ДОМЕН.ru
ADMIN_DASHBOARD_URL=https://ВАШ-ДОМЕН.ru

# Пароль дашборда после restore: 1111 (сменить в Настройках)
