# Скопируйте в .env и заполните значения
# cp .env.example .env

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# ID админов бота в Telegram (через запятую), для /admin в личке
TELEGRAM_ADMIN_IDS=123456789

# --- ProxyAPI / OpenAI (STT голосовых) ---
PROXY_API_KEY=replace-with-proxyapi-key
# или fallback:
# OPENAI_API_KEY=replace-with-openai-key
PROXY_BASE_URL=https://openai.api.proxyapi.ru/v1
OPENAI_MODEL_VOICE=whisper-1

# опционально, если используется в других интеграциях
# OPENAI_MODEL_TEXT=gpt-4o-mini

# --- PostgreSQL (обязательно для продакшена и админки) ---
DATABASE_URL=postgresql://kitchens:password@127.0.0.1:5433/kitchens

# --- Admin Web Dashboard (https://kitchen.alexklyvibe.ru) ---
ADMIN_DASHBOARD_USER=admin
# Пароль по умолчанию 1111 — задаётся в БД при первом запуске; смена в дашборде
# ADMIN_DASHBOARD_PASSWORD=1111
ADMIN_SESSION_SECRET=replace-with-random-string-min-32-chars
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8081
ADMIN_UPLOADS_DIR=/opt/kitchens-bot/uploads
# Базовый URL для фото каталога в Telegram-воронке (тот же домен админки)
CATALOG_PUBLIC_BASE_URL=https://kitchen.alexklyvibe.ru
ADMIN_DASHBOARD_URL=https://kitchen.alexklyvibe.ru
